---
import { SITE_TITLE } from '../consts';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
	<div class="header-inner">
		<!-- Logo Section -->
		<a href="/" class="brand-logo" aria-label={`${SITE_TITLE} Startseite`}>
			<img src="/logo.svg" alt="Lichtspielfreunde Logo" width="220" height="44" class="logo-image" />
		</a>

		<!-- Mobile Navigation Toggle -->
		<button
			type="button"
			class="mobile-toggle"
			id="mobile-nav-toggle"
			aria-controls="primary-navigation"
			aria-expanded="false"
			aria-label="Hauptmenü öffnen"
		>
			<span class="bar"></span>
			<span class="bar"></span>
			<span class="bar"></span>
		</button>

		<!-- Navigation Menu -->
		<nav id="primary-navigation" class="site-nav" aria-label="Hauptnavigation">
			<ul class="nav-list">
				<li class="nav-item">
					<a href="/" class={`nav-link ${currentPath === '/' ? 'active' : ''}`}>
						Home
					</a>
				</li>
				<li class="nav-item">
					<a href="/mitglied-werden" class={`nav-link ${currentPath === '/mitglied-werden' ? 'active' : ''}`}>
						Mitglied werden
					</a>
				</li>
				<li class="nav-item">
					<a href="/kontakt" class={`nav-link ${currentPath === '/kontakt' ? 'active' : ''}`}>
						Kontakt
					</a>
				</li>

				<!-- Dropdown "Mehr" -->
				<li class="nav-item dropdown">
					<button
						type="button"
						class={`nav-link dropdown-toggle ${['/newsletter', '/impressum', '/datenschutz'].includes(currentPath) ? 'active' : ''}`}
						aria-haspopup="true"
						aria-expanded="false"
						id="dropdown-mehr-btn"
					>
						<span>Mehr</span>
						<svg class="chevron-icon" viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
							<path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
						</svg>
					</button>
					<ul class="dropdown-menu" id="dropdown-mehr-menu" aria-labelledby="dropdown-mehr-btn">
						<li>
							<a href="/newsletter" class={`dropdown-item ${currentPath === '/newsletter' ? 'active' : ''}`}>
								Newsletter
							</a>
						</li>
						<li>
							<a href="/impressum" class={`dropdown-item ${currentPath === '/impressum' ? 'active' : ''}`}>
								Impressum
							</a>
						</li>
						<li>
							<a href="/datenschutz" class={`dropdown-item ${currentPath === '/datenschutz' ? 'active' : ''}`}>
								Datenschutz
							</a>
						</li>
					</ul>
				</li>

				<!-- Password-Protected "Programm" -->
				<li class="nav-item nav-item-admin">
					<a
						href="/programm"
						class={`nav-link nav-btn-programm ${currentPath.startsWith('/programm') ? 'active' : ''}`}
						title="Geschützter Programmbereich zur Filmverwaltung"
					>
						<svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true" class="lock-icon">
							<path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd" />
						</svg>
						<span>Programm</span>
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>

<script>
	// Toggle mobile menu and dropdown
	const toggleBtn = document.getElementById('mobile-nav-toggle');
	const nav = document.getElementById('primary-navigation');
	const dropdownBtn = document.getElementById('dropdown-mehr-btn');
	const dropdownContainer = dropdownBtn?.closest('.dropdown');

	if (toggleBtn && nav) {
		toggleBtn.addEventListener('click', () => {
			const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
			toggleBtn.setAttribute('aria-expanded', String(!expanded));
			nav.classList.toggle('is-open');
		});
	}

	if (dropdownBtn && dropdownContainer) {
		dropdownBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			const isExpanded = dropdownBtn.getAttribute('aria-expanded') === 'true';
			dropdownBtn.setAttribute('aria-expanded', String(!isExpanded));
			dropdownContainer.classList.toggle('is-active');
		});

		// Close dropdown when clicking outside
		document.addEventListener('click', (e) => {
			if (!dropdownContainer.contains(e.target as Node)) {
				dropdownBtn.setAttribute('aria-expanded', 'false');
				dropdownContainer.classList.remove('is-active');
			}
		});

		// Close on Escape key
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && dropdownContainer.classList.contains('is-active')) {
				dropdownBtn.setAttribute('aria-expanded', 'false');
				dropdownContainer.classList.remove('is-active');
				dropdownBtn.focus();
			}
		});
	}
</script>

<style>
	.site-header {
		background: #0f121a;
		border-bottom: 1px solid var(--border-subtle);
		position: sticky;
		top: 0;
		z-index: 100;
		backdrop-filter: blur(10px);
	}

	.header-inner {
		max-width: var(--container-width);
		margin: 0 auto;
		padding: 0.85rem 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.brand-logo {
		display: flex;
		align-items: center;
		text-decoration: none;
		outline-offset: 4px;
	}

	.logo-image {
		height: 42px;
		width: auto;
		display: block;
	}

	.site-nav {
		display: flex;
		align-items: center;
	}

	.nav-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nav-item {
		position: relative;
	}

	.nav-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.5rem 0.85rem;
		color: var(--text-secondary);
		font-weight: 500;
		font-size: 0.95rem;
		text-decoration: none;
		border-radius: var(--radius-sm);
		transition: all 0.2s ease;
		background: transparent;
		border: none;
		cursor: pointer;
		font-family: inherit;
	}

	.nav-link:hover,
	.dropdown:hover .dropdown-toggle {
		color: #fff;
		background: rgba(255, 255, 255, 0.05);
		text-decoration: none;
	}

	.nav-link.active {
		color: var(--gold-light);
		background: rgba(229, 169, 60, 0.1);
		font-weight: 600;
	}

	.chevron-icon {
		transition: transform 0.2s ease;
	}

	.dropdown.is-active .chevron-icon,
	.dropdown:hover .chevron-icon {
		transform: rotate(180deg);
	}

	/* Dropdown menu */
	.dropdown-menu {
		display: none;
		position: absolute;
		top: calc(100% + 0.4rem);
		left: 0;
		min-width: 175px;
		background: var(--bg-surface-elevated);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-sm);
		padding: 0.4rem;
		list-style: none;
		margin: 0;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
		z-index: 110;
	}

	.dropdown:hover .dropdown-menu,
	.dropdown.is-active .dropdown-menu {
		display: block;
	}

	.dropdown-item {
		display: block;
		padding: 0.55rem 0.85rem;
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.9rem;
		border-radius: 4px;
		transition: background 0.15s, color 0.15s;
	}

	.dropdown-item:hover {
		background: var(--bg-surface-hover);
		color: #fff;
		text-decoration: none;
	}

	.dropdown-item.active {
		color: var(--gold-light);
		background: rgba(229, 169, 60, 0.12);
	}

	/* Programm Button in Nav */
	.nav-btn-programm {
		background: rgba(229, 169, 60, 0.12);
		color: var(--gold-light);
		border: 1px solid rgba(229, 169, 60, 0.35);
		font-weight: 600;
		padding: 0.45rem 0.95rem;
	}

	.nav-btn-programm:hover {
		background: var(--gold);
		color: #0c0e14;
		border-color: var(--gold);
		box-shadow: 0 0 12px var(--gold-glow);
	}

	.lock-icon {
		opacity: 0.85;
	}

	/* Mobile Toggle */
	.mobile-toggle {
		display: none;
		flex-direction: column;
		justify-content: space-around;
		width: 36px;
		height: 36px;
		background: transparent;
		border: 1px solid var(--border-subtle);
		border-radius: 6px;
		padding: 6px;
		cursor: pointer;
	}

	.mobile-toggle .bar {
		width: 100%;
		height: 2px;
		background: var(--text-primary);
		border-radius: 2px;
		transition: all 0.2s ease;
	}

	@media (max-width: 820px) {
		.mobile-toggle {
			display: flex;
		}

		.site-nav {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: #11141e;
			border-bottom: 1px solid var(--border-subtle);
			padding: 1rem 1.25rem 1.5rem;
			display: none;
		}

		.site-nav.is-open {
			display: block;
		}

		.nav-list {
			flex-direction: column;
			align-items: stretch;
			gap: 0.3rem;
		}

		.dropdown-menu {
			position: static;
			box-shadow: none;
			background: rgba(0, 0, 0, 0.2);
			margin-top: 0.3rem;
			margin-left: 0.8rem;
		}

		.dropdown.is-active .dropdown-menu {
			display: block;
		}

		.nav-btn-programm {
			justify-content: center;
			margin-top: 0.5rem;
		}
	}
</style>
