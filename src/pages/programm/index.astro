---
export const prerender = false;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kinoprogramm-Verwaltung | Lichtspielfreunde e.V.</title>
    <style>
      body {
        font-family: var(--font-atkinson, system-ui, sans-serif);
        background: #0f172a;
        color: #f8fafc;
        margin: 0;
        padding: 2rem 1rem;
      }
      .container {
        max-width: 760px;
        margin: 0 auto;
        background: #1e293b;
        padding: 2rem;
        border-radius: 12px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
      }
      h1 {
        margin-top: 0;
        color: #f59e0b;
      }
      .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }
      .form-group {
        margin-bottom: 1.25rem;
        display: flex;
        flex-direction: column;
      }
      label {
        font-weight: 600;
        margin-bottom: 0.35rem;
        font-size: 0.9rem;
        color: #cbd5e1;
      }
      input,
      select,
      textarea {
        padding: 0.65rem;
        background: #0f172a;
        border: 1px solid #334155;
        color: #fff;
        border-radius: 6px;
        font-size: 1rem;
      }
      input:focus,
      select:focus,
      textarea:focus {
        outline: 2px solid #f59e0b;
        border-color: transparent;
      }
      .checkbox-group {
        flex-direction: row;
        align-items: center;
        gap: 0.5rem;
      }
      .checkbox-group input {
        width: auto;
      }
      .btn-group {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
      }
      button {
        flex: 1;
        padding: 0.75rem 1.25rem;
        font-size: 1rem;
        font-weight: bold;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.2s;
      }
      .btn-primary {
        background: #f59e0b;
        color: #000;
      }
      .btn-primary:hover {
        background: #d97706;
      }
      .btn-secondary {
        background: #334155;
        color: #fff;
      }
      .btn-secondary:hover {
        background: #475569;
      }
      .preview-img {
        max-height: 180px;
        margin-top: 0.5rem;
        border-radius: 6px;
        object-fit: cover;
        display: none;
      }
      #status {
        margin-top: 1rem;
        padding: 0.75rem;
        border-radius: 6px;
        display: none;
      }
      .status-success {
        background: #065f46;
        color: #a7f3d0;
      }
      .status-error {
        background: #881337;
        color: #fecdd3;
      }
      .secondary-actions {
        margin-top: 1rem;
        border-top: 1px solid #334155;
        padding-top: 1rem;
      }
      .btn-outline {
        background: transparent;
        color: #94a3b8;
        border: 1px solid #475569;
        text-align: center;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
      .btn-outline:hover {
        background: #334155;
        color: #f8fafc;
        border-color: #64748b;
      }
      .btn-link {
        font-size: 0.95rem;
      }
      body {
        background-image:
          linear-gradient(rgba(15, 18, 26, 0.25), rgba(15, 18, 26, 0.35)),
          url("/images/cp%20background.png");
        background-size: cover;
        background-position: center top;
        background-repeat: no-repeat;
        background-attachment: fixed;
        background-color: #0f121a;
        min-height: 100vh;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>🎬 Film ins Programm eintragen</h1>
      <p style="color: #94a3b8; font-size: 0.95rem;">
        Neue Filmvorführung anlegen. Bei korrektem Passwort wird der neue Film
        direkt gespeichert und angezeigt. Felder mit * sind Pflichtfelder!
      </p>

      <div id="status"></div>

      <form id="film-form">
        <div class="form-group">
          <label for="admin-pw">Admin-Passwort *</label>
          <input
            type="password"
            id="admin-pw"
            required
            placeholder="Passwort eingeben"
          />
        </div>

        <div class="grid">
          <div class="form-group">
            <label for="title">Filmtitel *</label>
            <input
              type="text"
              id="title"
              required
              placeholder="z.B. Casablanca"
            />
          </div>
          <div class="form-group">
            <label for="originalTitle">Originaltitel (optional)</label>
            <input
              type="text"
              id="originalTitle"
              placeholder="z.B. Casablanca"
            />
          </div>
        </div>

        <div class="grid">
          <div class="form-group">
            <label for="director">Regie</label>
            <input
              type="text"
              id="director"
              placeholder="z.B. Michael Curtiz"
            />
          </div>
          <div class="form-group">
            <label for="year">Erscheinungsjahr</label>
            <input type="number" id="year" min="1895" value="2024" />
          </div>
        </div>

        <div class="grid">
          <div class="form-group">
            <label for="runtime">Laufzeit (Minuten)</label>
            <input type="number" id="runtime" min="1" value="102" />
          </div>
          <div class="form-group">
            <label for="fsk">FSK-Freigabe *</label>
            <select id="fsk">
              <option value="0">FSK 0</option>
              <option value="6">FSK 6</option>
              <option value="12" selected>
                FSK 12
              </option>
              <option value="16">FSK 16</option>
              <option value="18">FSK 18</option>
            </select>
          </div>
        </div>

        <div class="grid">
          <div class="form-group">
            <label for="showtime">Datum & Uhrzeit der Vorstellung *</label>
            <input type="datetime-local" id="showtime" required />
          </div>
          <div class="form-group">
            <label for="genre">Genres (kommagetrennt)</label>
            <input
              type="text"
              id="genre"
              placeholder="Drama, Liebesfilm, Klassiker"
            />
          </div>
        </div>

        <div class="form-group">
          <label for="poster-file">Filmplakat (Bilddatei hochladen)</label>
          <input type="file" id="poster-file" accept="image/*" />
          <img id="poster-preview" class="preview-img" alt="Vorschau" />
        </div>

        <div class="form-group checkbox-group">
          <input type="checkbox" id="highlight" />
          <label for="highlight" style="margin:0; cursor:pointer;">
            ⭐ Als „Filmtipp des Quartals“ auf der Startseite hervorheben
          </label>
        </div>

        <div class="form-group">
          <label for="synopsis">Kurzbeschreibung / Synopsis</label>
          <textarea
            id="synopsis"
            rows="4"
            placeholder="Worum geht es im Film?"
          ></textarea>
        </div>

        <div class="grid">
          <div class="form-group">
            <label for="trailerUrl">Trailer URL (optional)</label>
            <input
              type="url"
              id="trailerUrl"
              placeholder="https://www.youtube.com/watch?v=..."
            />
          </div>
          <div class="form-group">
            <label for="ticketUrl">Ticket / Reservierungs-URL (optional)</label>
            <input type="url" id="ticketUrl" placeholder="https://..." />
          </div>
        </div>

        <div class="btn-group">
          <button type="submit" class="btn-primary" id="submit-btn">
            Direkt speichern
          </button>
          <button type="button" class="btn-secondary" id="download-btn">
            Als .md Datei herunterladen
          </button>
        </div>
        <!-- Navigation & Formular-Aktionen -->
        <div class="btn-group secondary-actions">
          <button type="button" class="btn-outline" id="reset-btn">
            ➕ Nächster Film
          </button>
          <a href="/" class="btn-outline btn-link">
            ← Zurück zur Startseite
          </a>
        </div>
      </form>
    </div>

    <script>
      let base64Image = "";
      let imageFileName = "";

      // Remember password in sessionStorage
      const pwInput = document.getElementById("admin-pw") as HTMLInputElement;
      const savedPw = sessionStorage.getItem("admin_pw");
      if (savedPw) pwInput.value = savedPw;

      // Handle Image Preview
      const fileInput = document.getElementById(
        "poster-file",
      ) as HTMLInputElement;
      const preview = document.getElementById(
        "poster-preview",
      ) as HTMLImageElement;

      fileInput.addEventListener("change", () => {
        const file = fileInput.files?.[0];
        if (file) {
          imageFileName = file.name;
          const reader = new FileReader();
          reader.onload = (e) => {
            base64Image = e.target?.result as string;
            preview.src = base64Image;
            preview.style.display = "block";
          };
          reader.readAsDataURL(file);
        }
      });

      function getPayload() {
        const title = (document.getElementById("title") as HTMLInputElement)
          .value;
        const slug = title
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/(^-|-$)/g, "");
        const genres = (
          document.getElementById("genre") as HTMLInputElement
        ).value
          .split(",")
          .map((g) => g.trim())
          .filter(Boolean);

        const frontmatter = {
          title,
          originalTitle: (
            document.getElementById("originalTitle") as HTMLInputElement
          ).value,
          director: (document.getElementById("director") as HTMLInputElement)
            .value,
          year: Number(
            (document.getElementById("year") as HTMLInputElement).value,
          ),
          runtime: Number(
            (document.getElementById("runtime") as HTMLInputElement).value,
          ),
          fsk: (document.getElementById("fsk") as HTMLSelectElement).value,
          genre: genres,
          showtime: (document.getElementById("showtime") as HTMLInputElement)
            .value,
          poster: imageFileName
            ? `/images/programm/${imageFileName}`
            : "/images/programm/placeholder.jpg",
          highlight: (document.getElementById("highlight") as HTMLInputElement)
            .checked,
          synopsis: (document.getElementById("synopsis") as HTMLTextAreaElement)
            .value,
          trailerUrl: (
            document.getElementById("trailerUrl") as HTMLInputElement
          ).value,
          ticketUrl: (document.getElementById("ticketUrl") as HTMLInputElement)
            .value,
        };

        return { slug, frontmatter, imageBase64: base64Image, imageFileName };
      }

      // Submit via GitHub API
      const form = document.getElementById("film-form") as HTMLFormElement;
      const statusDiv = document.getElementById("status") as HTMLDivElement;
      const submitBtn = document.getElementById(
        "submit-btn",
      ) as HTMLButtonElement;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const pw = pwInput.value;
        sessionStorage.setItem("admin_pw", pw);

        submitBtn.disabled = true;
        submitBtn.innerText = "Speichere...";
        statusDiv.style.display = "none";

        try {
          const payload = getPayload();
          const res = await fetch("/api/programm", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${pw}`,
            },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          if (!res.ok) throw new Error(data.error || "Fehler beim Speichern");

          statusDiv.className = "status-success";
          statusDiv.textContent = "✅ " + data.message;
          statusDiv.style.display = "block";
          form.reset();
          preview.style.display = "none";
          pwInput.value = pw;
        } catch (err: any) {
          statusDiv.className = "status-error";
          statusDiv.textContent = "❌ " + err.message;
          statusDiv.style.display = "block";
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerText = "Direkt auf GitHub speichern";
        }
      });

      // Fallback Download Button
      document.getElementById("download-btn")?.addEventListener("click", () => {
        const payload = getPayload();
        const mdContent = `---
title: "${payload.frontmatter.title}"
originalTitle: "${payload.frontmatter.originalTitle}"
director: "${payload.frontmatter.director}"
year: ${payload.frontmatter.year}
runtime: ${payload.frontmatter.runtime}
fsk: "${payload.frontmatter.fsk}"
genre:
${payload.frontmatter.genre.map((g: string) => `  - "${g}"`).join("\n")}
showtime: "${payload.frontmatter.showtime}"
poster: "${payload.frontmatter.poster}"
highlight: ${payload.frontmatter.highlight}
synopsis: "${payload.frontmatter.synopsis}"
trailerUrl: "${payload.frontmatter.trailerUrl}"
ticketUrl: "${payload.frontmatter.ticketUrl}"
---

${payload.frontmatter.synopsis}
`;
        const blob = new Blob([mdContent], {
          type: "text/markdown;charset=utf-8;",
        });
        const link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = `${payload.slug}.md`;
        link.click();
      });

      // --- "Nächster Film": Formular leeren & für neuen Film vorbereiten ---
      const resetBtn = document.getElementById("reset-btn");
      resetBtn?.addEventListener("click", () => {
        // 1. Eingabefelder zurücksetzen
        form.reset();

        // 2. Passwort wiederherstellen (damit man es nicht jedes Mal neu eintippen muss)
        const currentPw = sessionStorage.getItem("admin_pw") || "";
        if (pwInput) pwInput.value = currentPw;

        // 3. Bild-Upload und Vorschau zurücksetzen
        base64Image = "";
        imageFileName = "";
        if (preview) {
          preview.src = "";
          preview.style.display = "none";
        }

        // 4. Statusmeldung ausblenden
        if (statusDiv) {
          statusDiv.style.display = "none";
          statusDiv.textContent = "";
        }

        // 5. Fokus direkt auf das erste Feld (Filmtitel) setzen
        const titleInput = document.getElementById("title") as HTMLInputElement;
        titleInput?.focus();
        titleInput?.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    </script>
  </body>
</html>
