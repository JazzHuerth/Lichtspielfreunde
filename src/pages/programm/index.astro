---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import CookieBanner from '../../components/CookieBanner.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { CURRENT_QUARTER, SITE_TITLE, VEREIN_NAME } from '../../consts';

export const prerender = false;

// Load all existing programm movies
const movies = await getCollection('programm');
const sortedMovies = movies.sort(
	(a, b) => new Date(a.data.screeningDate).getTime() - new Date(b.data.screeningDate).getTime()
);

// Serialize movies for client-side editing
const initialMoviesJSON = JSON.stringify(
	sortedMovies.map((m) => ({
		id: m.id,
		slug: m.id.endsWith('.md') ? m.id : `${m.id}.md`,
		data: m.data,
		body: m.body,
	}))
);
---

<!doctype html>
<html lang="de">
	<head>
		<BaseHead title={`Programm-Verwaltung – ${SITE_TITLE}`} description="Passwortgeschützter Bereich zur Aufnahme und Bearbeitung von Kinofilmen als Markdown-Dateien." />
	</head>
	<body>
		<Header />

		<main class="admin-main">
			<!-- Password Gate Section (Shown if unauthenticated) -->
			<section id="auth-gate" class="auth-gate-section">
				<div class="auth-card card">
					<div class="auth-icon-wrap">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="36" height="36" class="lock-svg">
							<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
							<path d="M7 11V7a5 5 0 0 1 10 0v4"/>
						</svg>
					</div>
					<span class="sub-heading">Interner Bereich</span>
					<h1>Programm-Verwaltung</h1>
					<p class="auth-intro">
						Dieser Bereich ist passwortgeschützt. Hier können berechtigte Vereinsmitglieder neue Filme 
						mit Text und Foto ins Kinoprogramm aufnehmen und bestehende Filme als Markdown-Dateien bearbeiten.
					</p>

					<form id="login-form" class="login-form">
						<div class="form-group">
							<label for="admin-pw">Administrator-Passwort</label>
							<div class="password-input-wrap">
								<input 
									type="password" 
									id="admin-pw" 
									name="password" 
									required 
									placeholder="Passwort eingeben..."
									autocomplete="current-password"
								/>
								<button type="button" id="toggle-pw-visibility" class="pw-eye-btn" aria-label="Passwort anzeigen">
									👁️
								</button>
							</div>
						</div>

						<button type="submit" class="btn btn-primary full-width-btn" id="btn-login">
							Anmelden & Programm öffnen
						</button>

						<div id="login-error" class="alert alert-error" style="display: none;"></div>

						<p class="auth-hint">
							<small>Standardpasswort für Entwicklung: <code>lichtspiel2025</code> (konfigurierbar via <code>ADMIN_PASSWORD</code>)</small>
						</p>
					</form>
				</div>
			</section>

			<!-- Protected Dashboard Section (Shown if authenticated) -->
			<section id="admin-dashboard" class="admin-dashboard-section" style="display: none;">
				<div class="dashboard-header-bar">
					<div>
						<span class="badge badge-gold">Angemeldet</span>
						<h1>Kinoprogramm verwalten</h1>
						<p class="dash-subtitle">Erfassen und bearbeiten Sie Filme. Alle Einträge werden als Markdown-Dateien gespeichert.</p>
					</div>
					<div class="header-actions">
						<button type="button" class="btn btn-primary" id="btn-open-new-movie">
							➕ Neuen Film anlegen
						</button>
						<button type="button" class="btn btn-secondary btn-sm" id="btn-logout">
							Abmelden
						</button>
					</div>
				</div>

				<!-- Notification banner -->
				<div id="action-banner" class="alert" style="display: none;"></div>

				<!-- Tab Navigation -->
				<div class="tabs-nav">
					<button type="button" class="tab-btn active" data-tab="tab-list">
						🎬 Aktuelle Filme ({movies.length})
					</button>
					<button type="button" class="tab-btn" data-tab="tab-editor" id="tab-editor-btn">
						✏️ Film-Editor
					</button>
					<button type="button" class="tab-btn" data-tab="tab-settings">
						⚙️ GitHub & Netlify Speicher-Setup
					</button>
				</div>

				<!-- TAB 1: Movie List -->
				<div id="tab-list" class="tab-pane active">
					<div class="movies-table-card card">
						<div class="table-responsive">
							<table class="movies-table">
								<thead>
									<tr>
										<th>Plakat</th>
										<th>Titel & Dateiname</th>
										<th>Datum & Zeit</th>
										<th>Quartal</th>
										<th>FSK / Genre</th>
										<th>Status</th>
										<th class="text-right">Aktionen</th>
									</tr>
								</thead>
								<tbody id="movies-table-body">
									<!-- Dynamically populated or rendered -->
								</tbody>
							</table>
						</div>
					</div>
				</div>

				<!-- TAB 2: Film Editor -->
				<div id="tab-editor" class="tab-pane">
					<div class="editor-card card">
						<div class="editor-header">
							<h2 id="editor-heading">Neuen Film ins Programm aufnehmen</h2>
							<p>Geben Sie die Filminformationen ein. Beim Speichern wird eine formatierte <code>.md</code> Datei im Verzeichnis <code>src/content/programm/</code> erstellt.</p>
						</div>

						<form id="movie-form" class="movie-form">
							<input type="hidden" id="edit-slug" name="slug" />

							<div class="form-grid">
								<!-- Title -->
								<div class="form-group full-width">
									<label for="film-title">Filmtitel *</label>
									<input type="text" id="film-title" name="title" required placeholder="z.B. Casablanca" />
								</div>

								<!-- Date & Time -->
								<div class="form-group">
									<label for="film-date">Vorführungsdatum *</label>
									<input type="date" id="film-date" name="screeningDate" required />
								</div>

								<div class="form-group">
									<label for="film-time">Uhrzeit der Vorführung *</label>
									<input type="text" id="film-time" name="time" required value="20:00 Uhr" placeholder="z.B. 20:00 Uhr" />
								</div>

								<!-- Quarter & Month -->
								<div class="form-group">
									<label for="film-quarter">Quartal *</label>
									<input type="text" id="film-quarter" name="quarter" required value={CURRENT_QUARTER} placeholder="z.B. 1. Quartal 2025" />
								</div>

								<div class="form-group">
									<label for="film-month">Monat (für Filter)</label>
									<input type="text" id="film-month" name="month" placeholder="z.B. Januar 2025" />
								</div>

								<!-- Director & Year -->
								<div class="form-group">
									<label for="film-director">Regie</label>
									<input type="text" id="film-director" name="director" placeholder="z.B. Michael Curtiz" />
								</div>

								<div class="form-group">
									<label for="film-year">Erscheinungsjahr</label>
									<input type="number" id="film-year" name="year" placeholder="1942" min="1890" max="2030" />
								</div>

								<!-- Country & Duration -->
								<div class="form-group">
									<label for="film-country">Produktionsland</label>
									<input type="text" id="film-country" name="country" placeholder="z.B. USA" />
								</div>

								<div class="form-group">
									<label for="film-duration">Laufzeit</label>
									<input type="text" id="film-duration" name="duration" placeholder="z.B. 102 Min." />
								</div>

								<!-- FSK & Genre -->
								<div class="form-group">
									<label for="film-fsk">Altersfreigabe (FSK)</label>
									<select id="film-fsk" name="fsk">
										<option value="FSK 0">FSK 0</option>
										<option value="FSK 6">FSK 6</option>
										<option value="FSK 12" selected>FSK 12</option>
										<option value="FSK 16">FSK 16</option>
										<option value="FSK 18">FSK 18</option>
									</select>
								</div>

								<div class="form-group">
									<label for="film-genre">Genre</label>
									<input type="text" id="film-genre" name="genre" placeholder="z.B. Klassiker / Drama" />
								</div>

								<!-- Language & Location -->
								<div class="form-group">
									<label for="film-language">Sprachfassung</label>
									<input type="text" id="film-language" name="language" placeholder="z.B. OmU (Englisch mit dt. Untertiteln)" />
								</div>

								<div class="form-group">
									<label for="film-location">Spielort</label>
									<input type="text" id="film-location" name="location" value="Kino Lichtspielsaal" />
								</div>

								<!-- Special Note -->
								<div class="form-group full-width">
									<label for="film-special">Besonderheit / Rahmenprogramm (optional)</label>
									<input type="text" id="film-special" name="specialNote" placeholder="z.B. Sektempfang ab 19:15 Uhr & Regiegespräch" />
								</div>

								<!-- Photo Upload / URL Section -->
								<div class="form-group full-width photo-upload-box">
									<label>Filmplakat / Photo *</label>
									<div class="photo-controls-row">
										<div class="photo-file-input">
											<label for="film-photo-file" class="btn btn-secondary btn-sm file-label">
												📁 Foto vom Computer wählen
											</label>
											<input type="file" id="film-photo-file" accept="image/*" class="sr-only" />
											<span id="photo-filename" class="photo-hint">Keine neue Datei gewählt</span>
										</div>
										<div class="photo-or">oder Bild-Pfad:</div>
										<input type="text" id="film-photo-url" name="heroImage" placeholder="/images/programm/mein-film.jpg" value="/images/programm/casablanca.jpg" />
									</div>
									<!-- Preview Image -->
									<div class="photo-preview-wrap">
										<img id="photo-preview" src="/images/programm/casablanca.jpg" alt="Vorschau Filmplakat" class="photo-preview-img" />
										<span class="preview-label">Aktuelle Vorschau</span>
									</div>
								</div>

								<!-- Synopsis (Kurzbeschreibung) -->
								<div class="form-group full-width">
									<label for="film-desc">Kurzbeschreibung (Inhaltsangabe für Übersicht & Kärtchen) *</label>
									<textarea id="film-desc" name="description" rows="3" required placeholder="Faszinierende Zusammenfassung des Films..."></textarea>
								</div>

								<!-- Detailed Markdown Text -->
								<div class="form-group full-width">
									<label for="film-body">Ausführlicher Begleittext (Markdown) *</label>
									<textarea id="film-body" name="body" rows="8" placeholder="## Über den Film&#10;&#10;Detaillierte Analyse, Zitate, historische Einordnung..."></textarea>
									<small class="text-muted">Unterstützt Überschriften (##), Hervorhebungen (**fett**, *kursiv*), Zitate (&gt;) und Listen.</small>
								</div>

								<!-- Highlight Checkbox -->
								<div class="form-group full-width">
									<label class="checkbox-row">
										<input type="checkbox" id="film-highlight" name="highlight" />
										<span><strong>Als Highlight auf der Startseite hervorheben</strong> (Großes Banner)</span>
									</label>
								</div>
							</div>

							<!-- Actions -->
							<div class="editor-actions">
								<button type="submit" class="btn btn-primary" id="btn-save-movie">
									💾 Film als Markdown speichern
								</button>
								<button type="button" class="btn btn-secondary" id="btn-download-md">
									⬇️ Markdown-Datei (.md) herunterladen
								</button>
								<button type="button" class="btn btn-secondary" id="btn-copy-md">
									📋 In Zwischenablage kopieren
								</button>
								<button type="button" class="btn btn-secondary" id="btn-cancel-edit">
									Abbrechen
								</button>
							</div>
						</form>
					</div>
				</div>

				<!-- TAB 3: GitHub & Netlify Settings -->
				<div id="tab-settings" class="tab-pane">
					<div class="card settings-card">
						<h2>GitHub & Netlify Speicherung einrichten</h2>
						<p>
							Wenn Ihre App von GitHub aus auf Netlify bereitgestellt wird, werden neue Filme und Änderungen 
							direkt als Markdown-Dateien in Ihr GitHub-Repository übertragen und Netlify baut die Website automatisch neu.
						</p>

						<div class="settings-instructions">
							<h3>1. Automatische Speicherung per Netlify Umgebungsvariablen (Empfohlen)</h3>
							<p>Hinterlegen Sie in Ihrem Netlify Dashboard unter <em>Site configuration &rarr; Environment variables</em>:</p>
							<ul>
								<li><code>ADMIN_PASSWORD</code>: Ihr persönliches Passwort für diesen Bereich</li>
								<li><code>GITHUB_TOKEN</code>: Ein GitHub Personal Access Token (mit <em>repo</em>-Berechtigung)</li>
								<li><code>GITHUB_REPO</code>: Ihr Repository im Format <code>benutzername/lichtspielfreunde</code></li>
								<li><code>GITHUB_BRANCH</code>: <code>main</code></li>
							</ul>

							<h3>2. Lokales Arbeiten</h3>
							<p>
								Wenn Sie lokal mit <code>npm run dev</code> arbeiten, speichert der Klick auf „Film als Markdown speichern“ 
								die <code>.md</code> Datei direkt in den Ordner <code>src/content/programm/</code> auf Ihrer Festplatte!
							</p>

							<h3>3. Manueller Download</h3>
							<p>
								Sie können auch jederzeit den Button <strong>„Markdown-Datei herunterladen“</strong> nutzen und die Datei 
								direkt in Ihr Git-Repository legen.
							</p>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />
		<CookieBanner />

		<!-- Inject initial movie data -->
		<script id="initial-movies-data" type="application/json" set:html={initialMoviesJSON}></script>

		<script>
			// Client-Side Management Script
			const AUTH_SESSION_KEY = 'lichtspiel_admin_token_v1';
			const initialMoviesEl = document.getElementById('initial-movies-data');
			let moviesList: any[] = [];
			try {
				if (initialMoviesEl && initialMoviesEl.textContent) {
					moviesList = JSON.parse(initialMoviesEl.textContent);
				}
			} catch (e) {
				console.error('Error parsing initial movies:', e);
			}

			// DOM Elements
			const authGate = document.getElementById('auth-gate');
			const adminDashboard = document.getElementById('admin-dashboard');
			const loginForm = document.getElementById('login-form') as HTMLFormElement | null;
			const loginError = document.getElementById('login-error');
			const adminPwInput = document.getElementById('admin-pw') as HTMLInputElement | null;
			const togglePwBtn = document.getElementById('toggle-pw-visibility');
			const btnLogout = document.getElementById('btn-logout');
			const moviesTableBody = document.getElementById('movies-table-body');
			const actionBanner = document.getElementById('action-banner');

			// Tabs
			const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
			const tabPanes = document.querySelectorAll<HTMLElement>('.tab-pane');
			const tabEditorBtn = document.getElementById('tab-editor-btn');

			// Form
			const movieForm = document.getElementById('movie-form') as HTMLFormElement | null;
			const editorHeading = document.getElementById('editor-heading');
			const editSlugInput = document.getElementById('edit-slug') as HTMLInputElement | null;
			const filmTitleInput = document.getElementById('film-title') as HTMLInputElement | null;
			const filmDateInput = document.getElementById('film-date') as HTMLInputElement | null;
			const filmTimeInput = document.getElementById('film-time') as HTMLInputElement | null;
			const filmQuarterInput = document.getElementById('film-quarter') as HTMLInputElement | null;
			const filmMonthInput = document.getElementById('film-month') as HTMLInputElement | null;
			const filmDirectorInput = document.getElementById('film-director') as HTMLInputElement | null;
			const filmYearInput = document.getElementById('film-year') as HTMLInputElement | null;
			const filmCountryInput = document.getElementById('film-country') as HTMLInputElement | null;
			const filmDurationInput = document.getElementById('film-duration') as HTMLInputElement | null;
			const filmFskSelect = document.getElementById('film-fsk') as HTMLSelectElement | null;
			const filmGenreInput = document.getElementById('film-genre') as HTMLInputElement | null;
			const filmLangInput = document.getElementById('film-language') as HTMLInputElement | null;
			const filmLocationInput = document.getElementById('film-location') as HTMLInputElement | null;
			const filmSpecialInput = document.getElementById('film-special') as HTMLInputElement | null;
			const filmDescInput = document.getElementById('film-desc') as HTMLTextAreaElement | null;
			const filmBodyInput = document.getElementById('film-body') as HTMLTextAreaElement | null;
			const filmHighlightCheckbox = document.getElementById('film-highlight') as HTMLInputElement | null;
			const filmPhotoUrlInput = document.getElementById('film-photo-url') as HTMLInputElement | null;
			const filmPhotoFileInput = document.getElementById('film-photo-file') as HTMLInputElement | null;
			const photoFilenameSpan = document.getElementById('photo-filename');
			const photoPreviewImg = document.getElementById('photo-preview') as HTMLImageElement | null;

			const btnOpenNew = document.getElementById('btn-open-new-movie');
			const btnDownloadMd = document.getElementById('btn-download-md');
			const btnCopyMd = document.getElementById('btn-copy-md');
			const btnCancelEdit = document.getElementById('btn-cancel-edit');

			let uploadedPhotoBase64 = '';
			let uploadedPhotoName = '';

			// 1. Authentication Check
			function getSavedToken() {
				return sessionStorage.getItem(AUTH_SESSION_KEY);
			}

			function setToken(token: string) {
				sessionStorage.setItem(AUTH_SESSION_KEY, token);
			}

			function clearToken() {
				sessionStorage.removeItem(AUTH_SESSION_KEY);
			}

			function checkAuth() {
				const token = getSavedToken();
				if (token) {
					if (authGate) authGate.style.display = 'none';
					if (adminDashboard) adminDashboard.style.display = 'block';
					renderMoviesTable();
				} else {
					if (authGate) authGate.style.display = 'block';
					if (adminDashboard) adminDashboard.style.display = 'none';
				}
			}

			// Login submission
			if (loginForm) {
				loginForm.addEventListener('submit', async (e) => {
					e.preventDefault();
					const pw = adminPwInput?.value || '';
					if (loginError) loginError.style.display = 'none';

					try {
						const res = await fetch('/api/programm', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ action: 'login', password: pw }),
						});
						const data = await res.json();
						if (data.success) {
							setToken(data.token);
							checkAuth();
						} else {
							if (loginError) {
								loginError.textContent = 'Falsches Passwort. Bitte prüfen Sie Ihre Eingabe.';
								loginError.style.display = 'block';
							}
						}
					} catch (err: any) {
						if (loginError) {
							loginError.textContent = 'Verbindungsfehler: ' + err.message;
							loginError.style.display = 'block';
						}
					}
				});
			}

			// Toggle password visibility
			if (togglePwBtn && adminPwInput) {
				togglePwBtn.addEventListener('click', () => {
					const isPw = adminPwInput.type === 'password';
					adminPwInput.type = isPw ? 'text' : 'password';
					togglePwBtn.textContent = isPw ? '🙈' : '👁️';
				});
			}

			// Logout
			if (btnLogout) {
				btnLogout.addEventListener('click', () => {
					clearToken();
					checkAuth();
				});
			}

			// 2. Tab Navigation
			tabBtns.forEach((btn) => {
				btn.addEventListener('click', () => {
					const target = btn.dataset.tab;
					tabBtns.forEach((b) => b.classList.remove('active'));
					tabPanes.forEach((p) => p.classList.remove('active'));

					btn.classList.add('active');
					const pane = document.getElementById(target || '');
					if (pane) pane.classList.add('active');
				});
			});

			function switchTab(tabId: string) {
				const btn = document.querySelector<HTMLButtonElement>(`[data-tab="${tabId}"]`);
				if (btn) btn.click();
			}

			// 3. Render Movies Table
			function renderMoviesTable() {
				if (!moviesTableBody) return;
				if (moviesList.length === 0) {
					moviesTableBody.innerHTML = `<tr><td colspan="7" class="text-center">Noch keine Filme vorhanden. Klicken Sie auf "Neuen Film anlegen"!</td></tr>`;
					return;
				}

				moviesTableBody.innerHTML = moviesList
					.map((m) => {
						const date = new Date(m.data.screeningDate).toLocaleDateString('de-DE');
						const imgSrc = m.data.heroImage || '/images/programm/casablanca.jpg';
						const isHighlight = m.data.highlight ? '<span class="badge badge-gold">Highlight</span>' : '<span class="badge">Regulär</span>';

						return `
							<tr>
								<td>
									<img src="${imgSrc}" alt="${m.data.title}" class="table-thumb" />
								</td>
								<td>
									<strong>${m.data.title}</strong><br />
									<code class="slug-tag">${m.slug}</code>
								</td>
								<td>
									${date}<br />
									<small class="text-muted">${m.data.time || '20:00 Uhr'}</small>
								</td>
								<td>${m.data.quarter || '1. Quartal'}</td>
								<td>
									<span class="badge badge-fsk">${m.data.fsk || 'FSK 12'}</span><br />
									<small class="text-muted">${m.data.genre || ''}</small>
								</td>
								<td>${isHighlight}</td>
								<td class="text-right">
									<button type="button" class="btn btn-secondary btn-sm btn-edit" data-id="${m.id}">
										✏️ Bearbeiten
									</button>
									<button type="button" class="btn btn-secondary btn-sm btn-delete" data-id="${m.id}" data-slug="${m.slug}">
										🗑️
									</button>
								</td>
							</tr>
						`;
					})
					.join('');

				// Attach edit/delete handlers
				document.querySelectorAll<HTMLButtonElement>('.btn-edit').forEach((btn) => {
					btn.addEventListener('click', () => {
						const id = btn.dataset.id;
						const movie = moviesList.find((m) => m.id === id);
						if (movie) populateEditor(movie);
					});
				});

				document.querySelectorAll<HTMLButtonElement>('.btn-delete').forEach((btn) => {
					btn.addEventListener('click', async () => {
						const slug = btn.dataset.slug;
						if (confirm(`Möchten Sie den Film wirklich löschen (${slug})?`)) {
							await deleteMovie(slug || '');
						}
					});
				});
			}

			// 4. Editor Handling
			function populateEditor(movie: any) {
				if (editorHeading) editorHeading.textContent = `Film bearbeiten: ${movie.data.title}`;
				if (editSlugInput) editSlugInput.value = movie.slug;
				if (filmTitleInput) filmTitleInput.value = movie.data.title || '';
				if (filmDateInput) {
					const d = new Date(movie.data.screeningDate);
					filmDateInput.value = d.toISOString().split('T')[0];
				}
				if (filmTimeInput) filmTimeInput.value = movie.data.time || '20:00 Uhr';
				if (filmQuarterInput) filmQuarterInput.value = movie.data.quarter || '';
				if (filmMonthInput) filmMonthInput.value = movie.data.month || '';
				if (filmDirectorInput) filmDirectorInput.value = movie.data.director || '';
				if (filmYearInput) filmYearInput.value = movie.data.year || '';
				if (filmCountryInput) filmCountryInput.value = movie.data.country || '';
				if (filmDurationInput) filmDurationInput.value = movie.data.duration || '';
				if (filmFskSelect) filmFskSelect.value = movie.data.fsk || 'FSK 12';
				if (filmGenreInput) filmGenreInput.value = movie.data.genre || '';
				if (filmLangInput) filmLangInput.value = movie.data.language || '';
				if (filmLocationInput) filmLocationInput.value = movie.data.location || 'Kino Lichtspielsaal';
				if (filmSpecialInput) filmSpecialInput.value = movie.data.specialNote || '';
				if (filmDescInput) filmDescInput.value = movie.data.description || '';
				if (filmBodyInput) filmBodyInput.value = movie.body || '';
				if (filmHighlightCheckbox) filmHighlightCheckbox.checked = Boolean(movie.data.highlight);

				if (filmPhotoUrlInput) filmPhotoUrlInput.value = movie.data.heroImage || '';
				if (photoPreviewImg) photoPreviewImg.src = movie.data.heroImage || '/images/programm/casablanca.jpg';

				switchTab('tab-editor');
			}

			function resetEditor() {
				if (editorHeading) editorHeading.textContent = 'Neuen Film ins Programm aufnehmen';
				if (movieForm) movieForm.reset();
				if (editSlugInput) editSlugInput.value = '';
				if (filmTimeInput) filmTimeInput.value = '20:00 Uhr';
				if (filmQuarterInput) filmQuarterInput.value = '1. Quartal 2025';
				if (filmLocationInput) filmLocationInput.value = 'Kino Lichtspielsaal';
				if (photoPreviewImg) photoPreviewImg.src = '/images/programm/casablanca.jpg';
				if (photoFilenameSpan) photoFilenameSpan.textContent = 'Keine neue Datei gewählt';
				uploadedPhotoBase64 = '';
				uploadedPhotoName = '';
			}

			if (btnOpenNew) {
				btnOpenNew.addEventListener('click', () => {
					resetEditor();
					switchTab('tab-editor');
				});
			}

			if (btnCancelEdit) {
				btnCancelEdit.addEventListener('click', () => {
					resetEditor();
					switchTab('tab-list');
				});
			}

			// Handle photo file selection with preview & base64
			if (filmPhotoFileInput) {
				filmPhotoFileInput.addEventListener('change', (e) => {
					const files = filmPhotoFileInput.files;
					if (files && files[0]) {
						const file = files[0];
						uploadedPhotoName = file.name;
						if (photoFilenameSpan) photoFilenameSpan.textContent = file.name;

						const reader = new FileReader();
						reader.onload = (event) => {
							uploadedPhotoBase64 = event.target?.result as string;
							if (photoPreviewImg) photoPreviewImg.src = uploadedPhotoBase64;
							if (filmPhotoUrlInput) filmPhotoUrlInput.value = `/images/programm/${file.name}`;
						};
						reader.readAsDataURL(file);
					}
				});
			}

			if (filmPhotoUrlInput) {
				filmPhotoUrlInput.addEventListener('input', () => {
					if (photoPreviewImg && filmPhotoUrlInput.value) {
						photoPreviewImg.src = filmPhotoUrlInput.value;
					}
				});
			}

			// Generate Markdown string from form data
			function buildMovieDataFromForm() {
				return {
					slug: editSlugInput?.value,
					title: filmTitleInput?.value || '',
					screeningDate: filmDateInput?.value || '',
					time: filmTimeInput?.value || '20:00 Uhr',
					quarter: filmQuarterInput?.value || '1. Quartal 2025',
					month: filmMonthInput?.value || '',
					director: filmDirectorInput?.value || '',
					year: filmYearInput?.value ? parseInt(filmYearInput.value, 10) : undefined,
					country: filmCountryInput?.value || '',
					duration: filmDurationInput?.value || '',
					fsk: filmFskSelect?.value || 'FSK 12',
					genre: filmGenreInput?.value || '',
					language: filmLangInput?.value || '',
					location: filmLocationInput?.value || 'Kino Lichtspielsaal',
					specialNote: filmSpecialInput?.value || '',
					heroImage: filmPhotoUrlInput?.value || '/images/programm/casablanca.jpg',
					description: filmDescInput?.value || '',
					highlight: filmHighlightCheckbox ? filmHighlightCheckbox.checked : false,
					body: filmBodyInput?.value || '',
					photoBase64: uploadedPhotoBase64,
					photoName: uploadedPhotoName,
				};
			}

			function buildMarkdownString(movie: any) {
				return [
					'---',
					`title: ${JSON.stringify(movie.title)}`,
					`description: ${JSON.stringify(movie.description)}`,
					`screeningDate: ${movie.screeningDate}`,
					`time: ${JSON.stringify(movie.time)}`,
					`quarter: ${JSON.stringify(movie.quarter)}`,
					`month: ${JSON.stringify(movie.month)}`,
					`director: ${JSON.stringify(movie.director)}`,
					`year: ${movie.year || new Date().getFullYear()}`,
					`country: ${JSON.stringify(movie.country)}`,
					`duration: ${JSON.stringify(movie.duration)}`,
					`genre: ${JSON.stringify(movie.genre)}`,
					`fsk: ${JSON.stringify(movie.fsk)}`,
					`language: ${JSON.stringify(movie.language)}`,
					`specialNote: ${JSON.stringify(movie.specialNote)}`,
					`heroImage: ${JSON.stringify(movie.heroImage)}`,
					`highlight: ${movie.highlight}`,
					`location: ${JSON.stringify(movie.location)}`,
					'---',
					'',
					movie.body || `## Über den Film\n\n${movie.description}`,
					'',
				].join('\n');
			}

			// Form Submit: Save to API
			if (movieForm) {
				movieForm.addEventListener('submit', async (e) => {
					e.preventDefault();
					const movieData = buildMovieDataFromForm();
					const token = getSavedToken();

					showBanner('Film wird gespeichert...', 'info');

					try {
						const res = await fetch('/api/programm', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
								Authorization: `Bearer ${token}`,
							},
							body: JSON.stringify({
								action: 'save',
								token,
								movie: movieData,
								slug: movieData.slug,
							}),
						});
						const result = await res.json();
						if (result.success) {
							showBanner(`✅ ${result.message}`, 'success');

							// Update local list
							const existingIndex = moviesList.findIndex((m) => m.slug === result.fileName);
							const updatedEntry = {
								id: result.fileName.replace(/\.md$/, ''),
								slug: result.fileName,
								data: {
									...movieData,
									heroImage: result.savedImagePath || movieData.heroImage,
								},
								body: movieData.body,
							};

							if (existingIndex >= 0) {
								moviesList[existingIndex] = updatedEntry;
							} else {
								moviesList.unshift(updatedEntry);
							}

							renderMoviesTable();
							switchTab('tab-list');
						} else {
							showBanner(`❌ Fehler: ${result.error}`, 'error');
						}
					} catch (err: any) {
						showBanner(`❌ Speicherfehler: ${err.message}`, 'error');
					}
				});
			}

			// Delete film
			async function deleteMovie(slug: string) {
				const token = getSavedToken();
				try {
					const res = await fetch('/api/programm', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
							Authorization: `Bearer ${token}`,
						},
						body: JSON.stringify({ action: 'delete', slug, token }),
					});
					const data = await res.json();
					if (data.success) {
						moviesList = moviesList.filter((m) => m.slug !== slug && m.id !== slug);
						renderMoviesTable();
						showBanner(`Film ${slug} wurde gelöscht.`, 'info');
					} else {
						showBanner(`Fehler: ${data.error}`, 'error');
					}
				} catch (err: any) {
					showBanner(`Löschfehler: ${err.message}`, 'error');
				}
			}

			// Download Markdown (.md)
			if (btnDownloadMd) {
				btnDownloadMd.addEventListener('click', () => {
					const movieData = buildMovieDataFromForm();
					const mdContent = buildMarkdownString(movieData);
					const datePrefix = movieData.screeningDate || new Date().toISOString().split('T')[0];
					const sanitizedTitle = movieData.title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
					const filename = movieData.slug || `${datePrefix}-${sanitizedTitle}.md`;

					const blob = new Blob([mdContent], { type: 'text/markdown;charset=utf-8;' });
					const url = URL.createObjectURL(blob);
					const a = document.createElement('a');
					a.href = url;
					a.download = filename;
					a.click();
					URL.revokeObjectURL(url);
					showBanner(`Markdown-Datei "${filename}" heruntergeladen!`, 'success');
				});
			}

			// Copy Markdown to Clipboard
			if (btnCopyMd) {
				btnCopyMd.addEventListener('click', () => {
					const movieData = buildMovieDataFromForm();
					const mdContent = buildMarkdownString(movieData);
					navigator.clipboard.writeText(mdContent).then(() => {
						showBanner('Markdown-Inhalt in die Zwischenablage kopiert!', 'success');
					});
				});
			}

			function showBanner(text: string, type: 'success' | 'error' | 'info') {
				if (!actionBanner) return;
				actionBanner.textContent = text;
				actionBanner.className = `alert alert-${type}`;
				actionBanner.style.display = 'block';
				actionBanner.scrollIntoView({ behavior: 'smooth' });
				setTimeout(() => {
					if (actionBanner) actionBanner.style.display = 'none';
				}, 6000);
			}

			// Check url hash (e.g. #edit-slug)
			if (window.location.hash.startsWith('#edit-')) {
				const idToEdit = window.location.hash.replace('#edit-', '');
				const targetMovie = moviesList.find((m) => m.id === idToEdit || m.slug === `${idToEdit}.md`);
				if (targetMovie) {
					checkAuth();
					populateEditor(targetMovie);
				}
			} else {
				checkAuth();
			}
		</script>

