---
import BaseHead from "../components/BaseHead.astro";
import CookieBanner from "../components/CookieBanner.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import {
  SITE_TITLE,
  VEREIN_CITY,
  VEREIN_EMAIL,
  VEREIN_PHONE,
  VEREIN_POST_CITY,
  VEREIN_POST_STREET,
  VEREIN_STREET,
} from "../consts";
---

<!doctype html>
<html lang="de">
  <head>
    <BaseHead
      title={`Kontakt – ${SITE_TITLE}`}
      description={`Kontakt zu den CP Filmfreunden: Vereinsheim Ritterstraße 24, Hürth-Efferen.`}
    />
  </head>
  <body>
    <Header />

    <main>
      <div class="contact-layout">
        <section class="contact-info-col">
          <h1>Kontakt</h1>

          <div class="info-block">
            <h2>Adresse</h2>
            <p>
              <em>Geschäftsstelle / Vereinsheim:</em>
              <br />
              {VEREIN_STREET} | {VEREIN_CITY}
            </p>
            <p>
              <em>Post-/Lieferanschrift:</em>
              <br />
              {VEREIN_POST_STREET}
              <br />
              {VEREIN_POST_CITY}-Efferen
            </p>
          </div>

          <div class="info-block">
            <h2>Telefon</h2>
            <p>
              <a href={`tel:${VEREIN_PHONE.replace(/\s/g, "")}`}>
                {VEREIN_PHONE}
              </a>
            </p>
            <ul class="hours">
              <li>Montag bis Donnerstag 17 Uhr - 19 Uhr</li>
              <li>Freitag 17 Uhr - 21 Uhr</li>
              <li>Samstag 11 Uhr - 21 Uhr</li>
              <li>Sonntag 13 Uhr - 19 Uhr</li>
            </ul>
          </div>

          <div class="info-block">
            <h2>E-Mail</h2>
            <p>
              <a href={`mailto:${VEREIN_EMAIL}`}>{VEREIN_EMAIL}</a>
            </p>
          </div>
        </section>

        <section class="contact-form-col">
          <h2 class="form-title">Kontaktformular</h2>
          <form id="contact-form" class="contact-form">
            <div class="form-group">
              <label for="c-name">Name *</label>
              <input type="text" id="c-name" name="name" required />
            </div>
            <div class="form-group">
              <label for="c-email">Email *</label>
              <input type="email" id="c-email" name="email" required />
            </div>
            <div class="form-group">
              <label for="c-phone">Telefon</label>
              <input type="text" id="c-phone" name="telefon" />
            </div>
            <div class="form-group">
              <label for="c-subject">Betreff *</label>
              <input type="text" id="c-subject" name="subject" required />
            </div>
            <div class="form-group">
              <label for="c-message">Nachricht *</label>
              <textarea
                id="c-message"
                name="message"
                rows="6"
                required
              ></textarea>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">
                Nachricht senden
              </button>
            </div>
            <div
              id="contact-feedback"
              class="form-feedback"
              style="display: none;"
            ></div>
          </form>
        </section>
      </div>
    </main>

    <Footer />
    <CookieBanner />

    <script>
      const form = document.getElementById(
        "contact-form",
      ) as HTMLFormElement | null;
      const feedback = document.getElementById("contact-feedback");

      if (form && feedback) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const formData = new FormData(form);
          const name = formData.get("name");

          feedback.innerHTML = `
						<div class="alert alert-success">
							<h4>Vielen Dank, ${name}!</h4>
							<p>Ihre Nachricht wurde übermittelt. Wir melden uns so bald wie möglich bei Ihnen.</p>
						</div>
					`;
          feedback.style.display = "block";
          form.reset();
        });
      }
    </script>

    <style>
      .contact-layout {
        display: grid;
        grid-template-columns: 1fr 1.15fr;
        gap: 3rem;
      }

      h1 {
        font-size: 2.2rem;
        margin-bottom: 1.75rem;
      }

      .form-title {
        font-size: 2rem;
        margin-bottom: 1.5rem;
      }

      .info-block {
        margin-bottom: 2rem;
      }

      .info-block h2 {
        font-size: 1.2rem;
        margin-bottom: 0.6rem;
      }

      .info-block p,
      .hours {
        color: var(--text-secondary);
      }

      .hours {
        list-style: none;
        padding: 0;
        margin: 0.4rem 0 0;
      }

      .form-actions {
        display: flex;
        justify-content: flex-end;
      }

      .alert-success {
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid #10b981;
        border-radius: var(--radius-sm);
        padding: 1.25rem;
        margin-top: 1.25rem;
      }

      .alert-success h4 {
        color: #34d399;
        margin-bottom: 0.4rem;
      }

      .alert-success p {
        margin: 0;
        color: #d1fae5;
      }

      @media (max-width: 840px) {
        .contact-layout {
          grid-template-columns: 1fr;
        }

        .form-actions {
          justify-content: stretch;
        }

        .form-actions .btn {
          width: 100%;
        }
      }
      body {
        background-image:
          linear-gradient(rgba(15, 18, 26, 0.25), rgba(15, 18, 26, 0.35)),
          url("/images/cp%20background.png");
        background-size: cover;
        background-position: center top;
        background-repeat: no-repeat;
        background-attachment: fixed;
        background-color: #0f121a;
        min-height: 100vh;
        margin: 0;
      }
    </style>
  </body>
</html>
