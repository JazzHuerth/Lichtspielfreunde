---
import BaseHead from "../components/BaseHead.astro";
import CookieBanner from "../components/CookieBanner.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE, VEREIN_NAME } from "../consts";
---

<!doctype html>
<html lang="de">
  <head>
    <BaseHead
      title={`Newsletter – ${SITE_TITLE}`}
      description={`Newsletter An- und Abmeldung der ${VEREIN_NAME}.`}
    />
  </head>
  <body>
    <Header />

    <main>
      <div class="newsletter-wrapper">
        <h1 class="script-heading">Newsletter An-/ Abmeldung</h1>

        <form id="newsletter-form" class="newsletter-form">
          <div class="form-group">
            <label for="nl-name">Name:</label>
            <input type="text" id="nl-name" name="name" />
          </div>
          <div class="form-group">
            <label for="nl-vorname">Vorname:</label>
            <input type="text" id="nl-vorname" name="vorname" />
          </div>
          <div class="form-group">
            <label for="nl-email">E-Mail-Adresse:</label>
            <input type="email" id="nl-email" name="email" required />
          </div>

          <fieldset class="action-set">
            <legend>Sie möchten sich für unseren Newsletter</legend>
            <label class="radio-row">
              <input type="radio" name="action" value="subscribe" checked />
              anmelden
            </label>
            <label class="radio-row">
              <input type="radio" name="action" value="unsubscribe" />
              abmelden
            </label>
          </fieldset>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">
              Abschicken
            </button>
          </div>

          <div
            id="newsletter-feedback"
            class="form-feedback"
            style="display: none;"
          ></div>
        </form>

        <p class="privacy-link">
          <a href="/datenschutz">Datenschutzerklärung</a>
        </p>
      </div>
    </main>

    <Footer />
    <CookieBanner />

    <script>
      const form = document.getElementById(
        "newsletter-form",
      ) as HTMLFormElement | null;
      const feedback = document.getElementById("newsletter-feedback");

      if (form && feedback) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const formData = new FormData(form);
          const email = formData.get("email");
          const action = formData.get("action");
          const isSubscribe = action === "subscribe";

          feedback.innerHTML = `
						<div class="alert alert-success">
							<h4>${isSubscribe ? "Anmeldung erhalten" : "Abmeldung erhalten"}</h4>
							<p>${
                isSubscribe
                  ? `Wir haben Ihre Newsletter-Anmeldung für <strong>${email}</strong> entgegengenommen.`
                  : `Wir haben die Abmeldung für <strong>${email}</strong> entgegengenommen.`
              }</p>
						</div>
					`;
          feedback.style.display = "block";
          form.reset();
          const subscribe = form.querySelector(
            'input[value="subscribe"]',
          ) as HTMLInputElement | null;
          if (subscribe) subscribe.checked = true;
        });
      }
    </script>

    <style>
      .newsletter-wrapper {
        max-width: 520px;
        margin: 1rem auto 3rem;
      }

      .script-heading {
        font-size: clamp(2.4rem, 6vw, 3.6rem);
        margin-bottom: 2rem;
      }

      .action-set {
        border: none;
        padding: 0;
        margin: 1.25rem 0 1.5rem;
      }

      .action-set legend {
        padding: 0;
        margin-bottom: 0.6rem;
        color: var(--text-secondary);
        font-weight: 600;
      }

      .radio-row {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin-bottom: 0.35rem;
        cursor: pointer;
        color: var(--text-secondary);
      }

      .form-actions {
        display: flex;
        justify-content: flex-end;
      }

      .privacy-link {
        margin-top: 2.5rem;
      }

      .alert-success {
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid #10b981;
        border-radius: var(--radius-sm);
        padding: 1.25rem;
        margin-top: 1.25rem;
      }

      .alert-success h4 {
        color: #34d399;
        margin-bottom: 0.4rem;
      }

      .alert-success p {
        margin: 0;
        color: #d1fae5;
      }
      body {
        background-image:
          linear-gradient(rgba(15, 18, 26, 0.25), rgba(15, 18, 26, 0.35)),
          url("/images/cp%20background.png");
        background-size: cover;
        background-position: center top;
        background-repeat: no-repeat;
        background-attachment: fixed;
        background-color: #0f121a;
        min-height: 100vh;
        margin: 0;
      }
    </style>
  </body>
</html>
