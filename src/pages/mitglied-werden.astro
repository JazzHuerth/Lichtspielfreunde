---
import BaseHead from "../components/BaseHead.astro";
import CookieBanner from "../components/CookieBanner.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import {
  SITE_TITLE,
  VEREIN_NAME,
  VEREIN_POST_CARE_OF,
  VEREIN_POST_CITY,
  VEREIN_POST_STREET,
} from "../consts";
---

<!doctype html>
<html lang="de">
  <head>
    <BaseHead
      title={`Mitglied werden – ${SITE_TITLE}`}
      description={`Mitglied werden bei den ${VEREIN_NAME}. Aufnahmeantrag ausfüllen und im Vereinsheim abgeben oder per Post senden.`}
    />
  </head>
  <body>
    <Header />

    <main>
      <section class="member-layout">
        <div class="member-pdf-col">
          <iframe
            class="member-pdf"
            title="Mitgliedsantrag der CP Lichtspielfreunde Hürth"
            src="/docs/Aufnahmeantrag_Erwachsene.pdf"
          ></iframe>
          <a
            class="btn btn-secondary btn-sm"
            href="/docs/Aufnahmeantrag_Erwachsene.pdf"
            download
          >
            Aufnahmeantrag als PDF herunterladen
          </a>
        </div>

        <div class="member-copy-col">
          <h1 class="script-heading">Mitglied werden</h1>
          <p>
            Du möchtest Mitglied bei den CP Lichtspielfreunden Hürth werden?
          </p>
          <p>Kein Problem ...</p>
          <p>
            Fülle einfach den nebenstehenden Aufnahmeantrag aus und bringe uns
            diesen zu unseren Öffnungszeiten (Fr. ab 19 Uhr / Sa. ab 11 Uhr /
            So. ab 13 Uhr) im Vereinsheim vorbei oder schicke ihn per Post an
            die folgende Adresse:
          </p>
          <address>
            {VEREIN_NAME}
            <br />
            {VEREIN_POST_CARE_OF}
            <br />
            {VEREIN_POST_STREET}
            <br />
            {VEREIN_POST_CITY}
          </address>
        </div>
      </section>

      <section class="tiers-grid">
        <article class="tier-card card">
          <h2>ordentliches Mitglied</h2>
          <img
            src="/images/mitglied/ordentliches-mitglied.jpg"
            alt="Symbolbild für die ordentliche Mitgliedschaft"
          />
          <ul>
            <li>5 € Monatsbeitrag</li>
            <li>
              12 mal freier Zugang zu Vereinsveranstaltung (jeder weitere Besuch
              kostet 5 €)
            </li>
            <li>ermäßigter Eintritt bei öffentlichen Veranstaltungen</li>
          </ul>
        </article>

        <article class="tier-card card">
          <h2>Fördermitglied</h2>
          <img
            src="/images/mitglied/foerdermitglied.jpg"
            alt="Symbolbild für die Fördermitgliedschaft"
          />
          <ul>
            <li>20 Euro Monatsbeitrag</li>
            <li>freier Zugang zu allen Vereinsveranstaltungen</li>
            <li>freier Eintritt bei öffentlichen Veranstaltungen</li>
          </ul>
        </article>
      </section>
    </main>

    <Footer />
    <CookieBanner />

    <style>
      .member-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2.5rem;
        align-items: start;
        margin-bottom: 3.5rem;
      }

      .member-pdf {
        width: 100%;
        min-height: 640px;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
        background: #fff;
        margin-bottom: 0.85rem;
      }

      .member-copy-col {
        text-align: center;
      }

      .script-heading {
        font-size: clamp(2.6rem, 6vw, 4rem);
        margin-bottom: 1.25rem;
      }

      .member-copy-col p {
        color: #fff;
        font-size: 1.05rem;
      }

      address {
        font-style: normal;
        color: #fff;
        line-height: 1.7;
        margin-top: 1.25rem;
      }

      .tiers-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
      }

      .tier-card {
        text-align: center;
      }

      .tier-card h2 {
        font-size: 1.6rem;
        margin-bottom: 1rem;
      }

      .tier-card img {
        width: 100%;
        max-width: 360px;
        height: 220px;
        object-fit: cover;
        margin: 0 auto 1.25rem;
      }

      .tier-card ul {
        list-style: none;
        padding: 0;
        margin: 0;
        text-align: left;
        max-width: 420px;
        margin-inline: auto;
        color: var(--text-secondary);
      }

      .tier-card li {
        position: relative;
        padding-left: 1.1rem;
        margin-bottom: 0.55rem;
      }

      .tier-card li::before {
        content: "–";
        position: absolute;
        left: 0;
      }

      @media (max-width: 900px) {
        .member-layout,
        .tiers-grid {
          grid-template-columns: 1fr;
        }
      }
      body {
        background-image:
          linear-gradient(rgba(15, 18, 26, 0.25), rgba(15, 18, 26, 0.35)),
          url("/images/cp%20background.png");
        background-size: cover;
        background-position: center top;
        background-repeat: no-repeat;
        background-attachment: fixed;
        background-color: #0f121a;
        min-height: 100vh;
        margin: 0;
      }
    </style>
  </body>
</html>
